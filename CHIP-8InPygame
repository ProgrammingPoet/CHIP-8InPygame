
import random
import pygame
pygame.init()#initialisation
WINDOW = pygame.display.set_mode((640,320))#window resolution
pygame.display.set_caption("CHIP-8")#sets window title
CLOCK = pygame.time.Clock()#initialising fps functionalilty
RENDERING = True
Program_Counter_Register=0x200
Index_Register=0
STACK_LIST=[]
DELAY_TIMER=0
OPCODE=0
MEMORY = [0] * 4096
V = [0] * 16
SCREEN=[[0 for i in range(65)] for i in range(33)]
print(SCREEN[0])
KEYPAD = {
    pygame.K_1: 0x1,
    pygame.K_2: 0x2,
    pygame.K_3: 0x3,
    pygame.K_4: 0xC,
    pygame.K_q: 0x4,
    pygame.K_w: 0x5,
    pygame.K_e: 0x6,
    pygame.K_r: 0xD,
    pygame.K_a: 0x7,
    pygame.K_s: 0x8,
    pygame.K_d: 0x9,
    pygame.K_f: 0xE,
    pygame.K_z: 0xA,
    pygame.K_x: 0x0,
    pygame.K_c: 0xB,
    pygame.K_v: 0xF,
}
with open("ROM.ch8", "rb") as ROM:
    BINARY_DATA = ROM.read()
for INDEX,BYTE in enumerate(BINARY_DATA):
    MEMORY[0x200+INDEX]=BYTE

#gameloop
while RENDERING==True:
    
    Program_Counter_Register=Program_Counter_Register+2

    if SOUND_TIMER>0:
        SOUND_TIMER = SOUND_TIMER-1
    if DELAY_TIMER>0:
        DELAY_TIMER = DELAY_TIMER-1

    for event in pygame.event.get():#checks for inputs
        #quit from x button functionality
        if event.type == pygame.QUIT:
            RENDERING = False
    

    #opcodes(31/35)
    if OPCODE==0x00E0: #0x00E0
        WINDOW.fill((0,0,0))
        
    elif (OPCODE & 0xF000)>>12==0x6:#0x6XNN
        X=(OPCODE&0x0F00)>>8
        NN = OPCODE & 0x00FF          
        V[X] = NN
    elif (OPCODE & 0xF000)>>12==0x1:#0x1NNN
        ADDRESS=(OPCODE & 0x0FFF)
        Program_Counter_Register=ADDRESS
    elif (OPCODE & 0xF000)>>12==0x7:#0x7XNN
        NN=(OPCODE & 0x00FF)
        V[X]=(V[X]+NN)&0xFF
    elif (OPCODE & 0xF000)>>12==0xA:#0xANN
        Index_Register=(OPCODE & 0x0FFF)
    elif (OPCODE & 0xF000)>>12==0x2:#0x2NNN
        ADDRESS = OPCODE & 0x0FFF
        STACK_LIST.append(Program_Counter_Register)
        Program_Counter_Register = ADDRESS
    elif OPCODE == 0x00EE:#0x00EE
        Program_Counter_Register = STACK_LIST.pop()
    elif (OPCODE & 0xF000)>>12==0x3:#0x3XNN
        X = (OPCODE & 0x0F00)>>8
        NN = (OPCODE & 0x00FF)
        if V[X]== NN:
            Program_Counter_Register = Program_Counter_Register + 4
    elif (OPCODE & 0xF000)>>12==0x4:#0x4XNN
        X = (OPCODE & 0x0F00)>>8
        NN = (OPCODE & 0x00FF)
        if V[X] != NN:
            Program_Counter_Register = Program_Counter_Register + 4
    elif (OPCODE & 0xF00F)==0x5000:#0x5XY0
        X =(OPCODE & 0x0F00)>>8
        Y =(OPCODE & 0x00F0)>>4
        if V[X]==V[Y]:
            Program_Counter_Register = Program_Counter_Register + 4
    elif (OPCODE & 0xF00F)==0x9000:#0x9XY0
        X =(OPCODE & 0x0F00)>>8
        Y =(OPCODE & 0x00F0)>>4
        if V[X]!=V[Y]:
            Program_Counter_Register = Program_Counter_Register + 4
    elif (OPCODE & 0xF00F)==0x8000:#0x8XY0
        X =(OPCODE & 0x0F00)>>8
        Y =(OPCODE & 0x00F0)>>4
        V[X]=V[Y]
    elif (OPCODE & 0xF0FF)==0xF01E:#0xFX1E
        X = (OPCODE & 0x0F00)>>8
        Index_Register=(Index_Register+V[X])&0xFFFF
    elif (OPCODE & 0xF0FF)==0xF007:#0xFX07
        X = (OPCODE & 0x0F00)>>8
        V[X]=DELAY_TIMER
    elif (OPCODE & 0xF0FF)==0xF015:#0xFX15
        X = (OPCODE & 0x0F00)>>8
        DELAY_TIMER=V[X]
    elif (OPCODE & 0xF0FF)==0xF018:#0xFX18
        X = (OPCODE & 0x0F00)>>8
        SOUND_TIMER=V[X]
    elif (OPCODE & 0xF000)>>12==0xC:#0xCXNN
        X = (OPCODE & 0x0F00)>>8
        NN = (OPCODE & 0x00FF)
        RANDOM=random.randint(0,255)
        V[X]=(RANDOM & NN) & 0xFF
    elif (OPCODE & 0xF0FF)==0xF00A:#0xFX0A
        PAUSE=True
        while PAUSE==True:
            for event in pygame.event.get():#checks for inputs
                if event.type == pygame.KEYDOWN:
                    PAUSE=False
                    KEY_PRESSED=event.key
                    break
                
        X = (OPCODE & 0x0F00)>>8
        if KEY_PRESSED in KEYPAD:
            V[X]=KEYPAD[KEY_PRESSED]
    elif (OPCODE & 0xF00F)==0x8001:#0x8XY1
        X = (OPCODE & 0x0F00)>>8
        Y = (OPCODE & 0x00F0)>>4
        V[X]=V[X]|V[Y]
    elif (OPCODE & 0xF00F)==0x8002:#0x8XY2
        X = (OPCODE & 0x0F00)>>8
        Y = (OPCODE & 0x00F0)>>4
        V[X]=V[X] & V[Y]
    elif (OPCODE & 0xF00F)==0x8003:#0x8XY3
        X = (OPCODE & 0x0F00)>>8
        Y = (OPCODE & 0x00F0)>>4
        V[X]=V[X] ^ V[Y]
    elif (OPCODE & 0xF00F)==0x8004:#0x8XY4
        X = (OPCODE & 0x0F00)>>8
        Y = (OPCODE & 0x00F0)>>4
        RESULT=V[X]+V[Y]
        V[X]=RESULT&0xFF
        if RESULT<=0xFF:
            V[15]=0
        else:
            V[15]=1
    elif (OPCODE & 0xF00F)==0x8005:#0x8XY5
        if V[X]<V[Y]:
            V[15]=0
        else:
            V[15]=1
        V[X]=(V[X]-V[Y])&0xFF
    elif (OPCODE & 0xF00F)==0x8006:#0x8XY6
        V[15]=V[X]&0x1
        V[X]=V[X]>>1
    elif (OPCODE & 0xF00F)==0x8007:#0x8XY7
        if V[X]>V[Y]:
            V[15]=1
        else:
            V[15]=0
        V[X]=(V[Y]-V[X])&0xFF
    elif (OPCODE & 0xF0FF)==0xE09E:#0xEX9E
        X = (OPCODE & 0x0F00)>>8
        KEYS_DOWN = pygame.key.get_pressed()
        for PYKEY,HEXKEY in KEYPAD.items():
            if HEXKEY==V[X] and KEYS_DOWN[PYKEY]==True:
                Program_Counter_Register=Program_Counter_Register+2
    elif (OPCODE & 0xF0FF)==0xE0A1:#0xEXA1
        X = (OPCODE & 0x0F00)>>8
        KEYS_DOWN = pygame.key.get_pressed()
        for PYKEY,HEXKEY in KEYPAD.items():
            if HEXKEY==V[X] and KEYS_DOWN[PYKEY]==False:
                Program_Counter_Register=Program_Counter_Register+2
                break
    elif (OPCODE & 0xF00F)==0x800E:#0x8XYE
        X=(OPCODE & 0x0F00)>>8
        V[15]=(V[X] & 0x80)>>7
        V[X] = (V[X] & 0xFF)<<1
    elif (OPCODE & 0xF0FF)==0xF055:#0xFX55
        X = (OPCODE & 0x0F00)>>8
        for i in range(X+1):
            MEMORY[Index_Register+i]=V[i]
    elif (OPCODE & 0xF0FF)==0xF065:#0xFX65
        X = (OPCODE & 0x0F00)>>8
        for i in range(X+1):
            V[i]=MEMORY[Index_Register+i]
    elif (OPCODE & 0xF0FF)==0xF065:#0xFX29
        X = (OPCODE & 0x0F00)>>8
        Index_Register=V[X]*5
    elif (OPCODE & 0xF0FF)==0xF033:#0xFX33
        X = (OPCODE & 0x0F00)>>8
        MEMORY[Index_Register]=V[X]//100
        MEMORY[Index_Register+1]=(V[X]%100)//10
        MEMORY[Index_Register+2]=(V[X]%10)


    
    elif (OPCODE & 0xF000)==0xD000:#0xDXYN
        X = (OPCODE & 0x0F00)>>8
        Y = (OPCODE & 0x00F0)>>4
        N = (OPCODE & 0x000F)
        SCREEN[V[Y]][V[X]]=1
        for i in range(N+1):
            MEMORY[Index_Register]

        
        #SPRITE=pygame.Rect(V[X],V[Y],8*10,N*8*10)
        #pygame.draw.rect(WINDOW,(255,255,255),SPRITE)
        
        
        

        
        
            

    
    
    
                


    

    
    
    

    

        

    
            
        
        


    
        

    
        
        



    
    
            
            
        


    



    
    CLOCK.tick(60)#FPS lock

    pygame.display.flip()#render final image

    
